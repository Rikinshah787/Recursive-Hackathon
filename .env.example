# Copy to .env.local, fill in from Supabase -> Project Settings -> API Keys, then restart `npm run dev`.
# Apply the database schema first: npx supabase db push (migrations in supabase/migrations).
# Use the PUBLISHABLE (sb_publishable_...) or legacy anon key. NEVER the sb_secret_ key: it ends up in the browser.
# Leave these unset to play offline (local leaderboard only).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
